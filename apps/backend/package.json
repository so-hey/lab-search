{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/repositories/ZillizDocumentRepository.test.ts src/services/auth/SlackServiceAuthService.test.ts src/services/documents/chunkDocument.test.ts src/services/documents/chunkExtractedDocument.test.ts src/services/documents/deduplicateDocuments.test.ts src/services/documents/deepAnalysisStatistics.test.ts src/services/documents/deepAnalyzeDrive.test.ts src/services/documents/syncDrive.test.ts src/services/documents/extractors/GoogleSlidesDocumentExtractor.test.ts src/services/documents/extractors/OfficeDocumentExtractor.test.ts src/services/documents/source/GoogleDriveDocumentSource.test.ts src/services/embedding/CachedQueryEmbeddingProvider.test.ts src/services/embedding/VoyageEmbeddingProvider.test.ts src/services/embedding/LocalEmbeddingProvider.test.ts src/services/maintenance/keepFreeServicesAlive.test.ts src/services/reranking/VoyageReranker.test.ts src/services/search/cosineSimilarity.test.ts src/services/search/groupSearchResults.test.ts src/services/search/searchDocuments.test.ts src/services/search/searchEvaluation.test.ts src/services/feedback/saveFeedback.test.ts",
    "index:local": "node --env-file-if-exists=.env --import tsx scripts/index-local-documents.ts",
    "analyze:drive": "node --env-file-if-exists=.env --import tsx scripts/analyze-drive.ts",
    "analyze:drive:deep": "node --env-file-if-exists=.env --import tsx scripts/analyze-drive-deep.ts",
    "debug:drive-file": "node --env-file-if-exists=.env --import tsx scripts/debug-drive-file.ts",
    "sync:drive": "node --env-file-if-exists=.env --import tsx scripts/sync-drive.ts",
    "evaluate:search": "node --env-file-if-exists=.env --import tsx scripts/evaluate-search.ts",
    "setup:zilliz": "node --env-file-if-exists=.env --import tsx scripts/setup-zilliz.ts",
    "migrate:zilliz-to-hybrid": "node --env-file-if-exists=.env --import tsx scripts/migrate-zilliz-to-hybrid.ts",
    "keepalive:free-services": "node --env-file-if-exists=.env --import tsx scripts/keep-free-services-alive.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@lab-search/shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "@zilliz/milvus2-sdk-node": "2.5.13",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.0.2",
    "hono": "^4.9.6",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.9.5",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
