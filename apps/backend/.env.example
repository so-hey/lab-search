PORT=8787
CORS_ORIGIN=http://localhost:3000

# Search/runtime mode: local | zilliz | qdrant
# Keep local values for Phase 1 development. Zilliz is the recommended Phase 2 store.
SEARCH_MODE=local
EMBEDDING_PROVIDER=local
# Retrieval: dense | hybrid（hybridはZillizのdense + BM25をRRF統合）
SEARCH_STRATEGY=dense
# Final reranking: none | voyage
RERANKER_PROVIDER=none
# VOYAGE_RERANK_MODEL=rerank-2.5-lite
# RERANK_CANDIDATE_DOCUMENTS=20
# VOYAGE_RERANK_MAX_RETRIES=4
# Billing未設定時はVoyageの3 RPM制限に合わせます。課金設定後はdashboardの上限に合わせて変更できます。
# VOYAGE_RERANK_REQUESTS_PER_MINUTE=3
# LOCAL_EMBEDDING_DIMENSIONS=384

# Phase 2 semantic search (Gemini)
# SEARCH_MODE=zilliz
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_DIMENSIONS=768
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 分間quotaを使い切らないよう、free tierの100 RPMより少し低く制限します。
# GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=90
# 一時的な429はGoogleのretryDelayに従って自動再試行します。
# GEMINI_EMBEDDING_MAX_TEMPORARY_RETRIES=8
# Vector DBへcheckpoint保存するEmbedding batchの件数（1〜100）
# 小さくするほど日次quota到達時の未使用枠を減らせます。
# EMBEDDING_SYNC_BATCH_SIZE=20

# Phase 2 semantic search (Voyage AI: high-throughput option)
# Geminiとはvectorを混在させず、必ず新しいcollection名を使用してください。
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_DIMENSIONS=1024
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-4-lite
# VOYAGE_EMBEDDING_MAX_RETRIES=8
# 支払い方法未登録時の制限。登録後はDashboardの実際の上限へ変更できます。
# VOYAGE_EMBEDDING_REQUESTS_PER_MINUTE=3
# VOYAGE_EMBEDDING_TOKENS_PER_MINUTE=10000
# 未課金枠では小刻みにcheckpoint保存するため5を推奨。Tier 1では100も選択可能です。
# EMBEDDING_SYNC_BATCH_SIZE=5

# Zilliz Cloud Free cluster（server-only）
# ZILLIZ_ENDPOINT=https://your-cluster-endpoint
# ZILLIZ_TOKEN=
# ZILLIZ_COLLECTION=document_chunks
# Voyage example: ZILLIZ_COLLECTION=document_chunks_voyage4_lite_1024
# Hybrid example: ZILLIZ_COLLECTION=document_chunks_voyage4_lite_1024_hybrid
# 既存dense collectionを無再Embeddingでhybridへ移行するときだけ使用します。
# ZILLIZ_SOURCE_COLLECTION=document_chunks_voyage4_lite_1024

# Legacy / migration source: Qdrant Cloud
# SEARCH_MODE=qdrant
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_COLLECTION=document_chunks

# Supabase (server-only; prefer the current secret key)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key

# Drive: service account JSON OR OAuth client + refresh token
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ACKNOWLEDGE_ABUSE=false
# DRIVE_ANALYSIS_CONCURRENCY=3

# Access control
AUTH_MODE=disabled
# AUTH_MODE=google
# Slack BotからBackendを呼ぶ場合は2つを同時に設定します。
# 生成例: openssl rand -hex 32
# SLACK_BACKEND_SERVICE_TOKEN=
# SLACK_ALLOWED_TEAM_ID=T0123456789
# LOCAL_SAMPLE_DIR=/absolute/path/to/pdfs
# LOCAL_INDEX_PATH=/absolute/path/to/local-index.json
