# Slack App credentials
SLACK_BOT_TOKEN=xoxb-...

# Local development: Socket Mode (recommended until a public Request URL exists)
SLACK_SOCKET_MODE=true
SLACK_APP_TOKEN=xapp-...

# HTTP mode only
# SLACK_SOCKET_MODE=false
# SLACK_SIGNING_SECRET=...
# PORT=3001

# Search command
SLACK_SEARCH_COMMAND=/lab-search

# Backend service-to-service authentication
BACKEND_URL=http://localhost:8787
SLACK_BACKEND_SERVICE_TOKEN=generate-with-openssl-rand-hex-32

# users.info APIの呼び出しを減らすmemory cache（秒・最大件数）
SLACK_IDENTITY_CACHE_TTL_SECONDS=3600
SLACK_IDENTITY_CACHE_MAX_ENTRIES=500
